# Browser-safe configuration
# VITE_* values are embedded in the browser bundle. A Supabase publishable key
# is designed for public clients and is still protected by Row Level Security.
VITE_SUPABASE_PROJECT_ID=twixqnbgmcelbkryoezg
VITE_SUPABASE_URL=https://twixqnbgmcelbkryoezg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<production-publishable-key>

# Server-only configuration
# These unprefixed values are read only by the server runtime.
SUPABASE_PROJECT_ID=twixqnbgmcelbkryoezg
SUPABASE_URL=https://twixqnbgmcelbkryoezg.supabase.co
SUPABASE_PUBLISHABLE_KEY=<production-publishable-key>

# Privileged server-only configuration -- NEVER expose through VITE_*.
# This key bypasses RLS. Store the real value only in the deployment secret
# manager; never commit it, log it, or use it in browser code.
SUPABASE_SERVICE_ROLE_KEY=<production-service-role-key>
